
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "moduleDetection": "legacy",
    "lib": ["ES2020", "DOM"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "isolatedModules": false,
    "verbatimModuleSyntax": false,

    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,

    "noEmitOnError": true
  },
  "files": ["script.ts"]
}
